    <color name="surface2">#FF1D2127</color>
    <color name="surface3">#FF262B33</color>
    <color name="stroke">#FF2B3038</color>
    <color name="fg">#FFF2F4F7</color>
    <color name="fg2">#FFC4CBD4</color>
    <color name="muted">#FF8B949E</color>
    <color name="accent">#FF6E8BFF</color>
